# Copy to .env and fill in, or just run ./install.sh which generates this
# automatically with strong random secrets.

DOMAIN=vault.example.com

DB_USER=vault
DB_PASSWORD=change-me
DB_NAME=vault

MINIO_ROOT_USER=vaultmedia
MINIO_ROOT_PASSWORD=change-me

COMPREFACE_DB_PASSWORD=change-me
COMPREFACE_ADMIN_EMAIL=admin@vault.example.com
COMPREFACE_ADMIN_PASSWORD=change-me
COMPREFACE_RECOGNITION_API_KEY=

JWT_SECRET=change-me
ADMIN_PANEL_SECRET=change-me

FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Left blank on purpose -- defaults to the deployment's own https://$DOMAIN,
# which is correct for the admin panel's cookie session. Only set this
# (comma-separated) if the admin panel genuinely needs another origin.
CORS_ORIGINS=
